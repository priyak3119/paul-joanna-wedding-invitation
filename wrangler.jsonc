{
  "name": "wedding-invitation",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "build": {
    "command": "node cloudflare-build.mjs"
  },
  "assets": {
    "directory": "./cloudflare-public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
